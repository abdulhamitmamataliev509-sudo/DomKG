# Flask
FLASK_ENV=development        # development | production
SECRET_KEY=change-me-secret
JWT_SECRET_KEY=change-me-jwt-secret

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=domkg_db

# Же жогорудагылардын ордуна бүтүндөй туташуу сабы (URL) берсе болот:
# DATABASE_URL=postgresql://user:pass@localhost:5432/domkg_db

# JWT өмүр мөөнөтү
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# Rate limiting
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://          # prod'то: redis://default:pass@host:6379/0
RATE_LIMIT_LOGIN=10 per minute
RATE_LIMIT_REGISTER=5 per minute

# Email тастыктоо (кийинки фаза)
REQUIRE_EMAIL_VERIFICATION=false
