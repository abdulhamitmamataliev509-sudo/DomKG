# DomKG backend - айлана-чөйрө өзгөрмөлөрүнүн шаблону
# КӨЧҮРҮП (.env деп), маанилериңизди толтуруңуз.
# .env git'ке КИРБЕЙТ (.gitignore'да). Мында ЧЫНЫГЫ сыр жазбаңыз.

# --- Flask ---
FLASK_ENV=development        # development | production (production'до милдеттүү!)

# --- Секреттер (production'до МИЛДЕТТҮҮ env'ден келиши керек; башталыш учурунда
#      жетишпесе сервер ката берет — fail-fast) ---
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# --- PostgreSQL ---
# Эки варианттын бирин колдонуңуз:
# (1) бүтүндөй туташуу сабы:
# DATABASE_URL=postgresql://user:pass@localhost:5432/domkg_db
# (2) же бөлүк-бөлүк:
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=domkg_db

# --- JWT өмүр мөөнөтү ---
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# --- Rate limiting ---
RATELIMIT_ENABLED=true
# Production: Redis милдеттүү (мөөнөтү тийиш) — бир нече worker үчүн.
#   pip install redis  (керек болсо)  жана:
# RATELIMIT_STORAGE_URI=redis://default:pass@host:6379/0
# Development (жергиликтүү): memory:// жетиштүү.
RATELIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=10 per minute
RATE_LIMIT_REGISTER=5 per minute

# --- CORS: уруксат берилген origin'дер (wildcard "*" эмес) ---
CORS_ORIGINS=http://localhost:5501,http://127.0.0.1:5501
# Production'до реалдуу frontend домени (мис. https://domkg.kg):
# CORS_ORIGINS=https://domkg.kg
CORS_ALLOW_CREDENTIALS=false

# --- Swagger / API doc (/apidocs/) ---
# Development: true; Production: false (коргоосуз ачык калбасын)
SWAGGER_ENABLED=true

# --- Email тастыктоо (кийинки фаза) ---
REQUIRE_EMAIL_VERIFICATION=false
